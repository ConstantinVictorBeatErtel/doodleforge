# --- Capture CLI (scripts/world.mjs) ---------------------------------------
# Copy to .env.local. World Labs Platform API key, not a Marble website login
# token. API billing is separate from Marble website credits.
WORLDLABS_API_KEY=

# --- Web app (Vite) --------------------------------------------------------
# Written automatically by `npx convex dev`
VITE_CONVEX_URL=

# --- Backend secrets -------------------------------------------------------
# Set these in the Convex dashboard (Settings -> Environment Variables) or via
# `npx convex env set WLT_API_KEY xxx` -- they are never read from this file.
# WLT_API_KEY=        World Labs (platform.worldlabs.ai)
# FAL_KEY=           fal image editing/cutout for sketch-to-object generation
# TRIPO_API_KEY=      Tripo (platform.tripo3d.ai)  tsk_...
# MINT_API_KEY=       mint.gg (platform.mint.gg)
# OPENROUTER_API_KEY=      which way round a sketched object faces. Only used when the viewer
#                          is opened with ?vision=1; otherwise orientation is the geometric
#                          silhouette sweep alone, which costs no network round trip.
# OPENROUTER_VISION_MODEL= overrides the default google/gemini-3.8-flash
# Configure conservative maximum USD amounts on Convex before enabling generation;
# missing values fail closed. These are provider-account prices, not user quotas.
# WORLD_LABS_MAX_DRAFT_USD=
# WORLD_LABS_MAX_STANDARD_USD=
# WORLD_LABS_MAX_PLUS_USD=
# TRIPO_MAX_JOB_USD=
# SKETCH_MAX_JOB_USD=      combined maximum for fal + Tripo + optional orientation
# ANTHROPIC_API_KEY=  for @convex-dev/agent NPCs (optional)

# Local drawing viewer: also editable in its Settings modal. Server-only.
FAL_KEY=
TRIPO_API_KEY=
